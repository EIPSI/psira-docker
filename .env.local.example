###########################################################
# General Setup (Local Dev)
###########################################################

### VERSION ############################################################################################################
APP_VERSION=local

### Data Path ##########################################################################################################
# Local paths (ignored by git)
DATA_SAVE_PATH=~/eipsi/psira/psira-data

### Backup Utility Config ##########################################################################################################
DATA_BACKUP_PATH=./.backups
DATA_BACKUP_LOG_PATH=./logs/backup

### Docker Host IP #####################################################################################################
# For extra_hosts "dockerhost:..."
# On Linux/WSL this can be 127.0.0.1 safely for most cases
DOCKER_HOST_IP=127.0.0.1

###########################################################
# PSIRA / Backend
###########################################################

# Initial super admin credentials (dev only)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Dev-only JWT secret (DO NOT USE IN PROD)
JWT_SECRET=dev-insecure-secret

# Enable GraphQL Playground in dev
GRAPHQL_PLAYGROUND_ENABLED=true

###########################################################
# Caddy Webserver (Local Dev)
###########################################################

# Local access
SITE_DOMAIN=psira.localhost

# Non-privileged ports (no sudo)
CADDY_HOST_HTTP_PORT=8080
CADDY_HOST_HTTPS_PORT=8443

# Logs & Caddyfile path (relative to psira-infra repo root)
CADDY_HOST_LOG_PATH=./logs/caddy
CADDY_CUSTOM_CADDYFILE=./caddy/Caddyfile

###########################################################
# Redis
###########################################################
REDIS_PORT=6379

###########################################################
# Postgres
###########################################################
POSTGRES_HOST=postgres
POSTGRES_DB=psira
POSTGRES_USER=psira
POSTGRES_PASSWORD=psira
POSTGRES_PORT=5432

###########################################################
# MongoDB
###########################################################
MONGODB_PORT=27017
MONGODB_CONNECTION_STRING=mongodb://mongo:27017/questionnaireDB

###########################################################
# Shiny (optional in local dev, but must be set to avoid invalid volume spec)
###########################################################
# Use a local folder inside the repo (easy)
SHINY_APPS_PATH=./psira-shiny

###########################################################
# Mailer (disabled in dev)
###########################################################
FRONTEND_MAIL=false
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
SENDER_MAIL=

# Dev-only key; must not be empty because backend may expect it
FRONTEND_ENCRYPTION_KEY=dev-insecure-frontend-key

# Used by backend to generate links
APP_URL=https://psira.localhost:8443
