# ============================
# Local development environment
# ============================

APP_VERSION=local

# Domain (local only)
SITE_DOMAIN=localhost,127.0.0.1

# Non-privileged ports for local dev
CADDY_HOST_HTTP_PORT=8080
CADDY_HOST_HTTPS_PORT=8443

# Local data paths (ignored by git)
DATA_SAVE_PATH=./.data
DATA_BACKUP_PATH=./.backups
DATA_BACKUP_LOG_PATH=./logs/backup

# Dev-only database credentials
POSTGRES_DB=psira
POSTGRES_USER=psira
POSTGRES_PASSWORD=psira

# Dev-only secrets
JWT_SECRET=dev-insecure-secret

# Debugging
GRAPHQL_PLAYGROUND_ENABLED=true
NODE_ENV=development
LOG_LEVEL=debug

# Frontend
FRONTEND_MAIL=false
APP_URL=http://localhost:8080
